<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Counter"
             x:Class="Counter.MainPage"
             Title="Counter - WiktorW 4E"
             Shell.TitleColor="#1443c4">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Border Stroke="#222" StrokeThickness="1" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Dodaj nowy licznik" FontAttributes="Bold" FontSize="18" />

                    <Entry x:Name="CounterNameEntry" Placeholder="Nazwa licznika" />
                    <Entry x:Name="InitialValueEntry" Placeholder="Wartosc poczatkowa" Keyboard="Numeric" />

                    <Button Text="Dodaj licznik" Clicked="OnAddCounterClicked" BackgroundColor="#1443c4" TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <CollectionView ItemsSource="{Binding Counters}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:CounterModel">
                        <Border Stroke="#222" StrokeThickness="1" Margin="0,5" Padding="10">
                            <Grid ColumnDefinitions="*, Auto, Auto, Auto, Auto" ColumnSpacing="10" VerticalOptions="Center">

                                <Label Grid.Column="0" Text="{Binding Name}" VerticalOptions="Center" FontAttributes="Bold" FontSize="16" />

                                <Label Grid.Column="1" Text="{Binding Value}" VerticalOptions="Center" FontSize="18" HorizontalTextAlignment="Center" />

                                <Button Grid.Column="2" Text="-" Clicked="OnDecrementClicked" CommandParameter="{Binding .}" BackgroundColor="#0a2570"
                                        WidthRequest="45" FontAttributes="Bold"  TextColor="#FFF"/>

                                <Button Grid.Column="3" Text="+" Clicked="OnIncrementClicked" CommandParameter="{Binding .}" BackgroundColor="#0c3094"
                                        WidthRequest="45" FontAttributes="Bold" TextColor="#FFF"/>

                                <Button Grid.Column="4" Text="X" Clicked="OnDeleteClicked" CommandParameter="{Binding .}" BackgroundColor="#940c0c"
                                        TextColor="#FFF" WidthRequest="40" FontAttributes="Bold" />  <!-- artysta to ja nie zostane -->
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>